{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "opensw",
  "version": "0.7.0",
  "identifier": "org.opensw.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "opensw",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "opensw contributors",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "opensw: an open-source math editor modelled on Scientific Word 5.5",
    "resources": {
      "tex55/": "tex55/",
      "../engine/engines.json": "engine/engines.json",
      "../engine/opensw_compute.wl": "engine/opensw_compute.wl",
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "fileAssociations": [
      {
        "ext": [
          "sci"
        ],
        "name": "Scientific Word document",
        "description": "Scientific Word 6 document (.sci)",
        "role": "Editor",
        "mimeType": "application/x-scientificword"
      }
    ]
  },
  "mainBinaryName": "opensw"
}
