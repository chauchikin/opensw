{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "opensw",
  "version": "0.1.0",
  "identifier": "com.ckwinlose.swnext",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "opensw",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "opensw：照 Scientific Word 5.5 重做的開源數學編輯器",
    "resources": {
      "tex55/": "tex55/"
    },
    "fileAssociations": [
      {
        "ext": [
          "sci"
        ],
        "name": "Scientific Word document",
        "description": "Scientific Word 6 文件（.sci）",
        "role": "Editor",
        "mimeType": "application/x-scientificword"
      }
    ]
  },
  "mainBinaryName": "opensw"
}
